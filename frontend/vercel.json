{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://api.elevenautoparts.com.br/api/:path*"
        },
        {
            "source": "/auth/:path*",
            "destination": "https://api.elevenautoparts.com.br/auth/:path*"
        },
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ]
}